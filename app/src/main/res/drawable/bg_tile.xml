<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26FFFFFF">
    <item>
        <selector
            android:enterFadeDuration="220"
            android:exitFadeDuration="220">
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_bg" />
                    <stroke android:width="1.5dp" android:color="@color/accent" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/card" />
                    <stroke android:width="1dp" android:color="@color/card_stroke" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
