<Window x:Class="EchoKey.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:EchoKey.Core"
        Title="EchoKey" Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        FlowDirection="{Binding FlowDirection, Source={x:Static core:Loc.I}}">
    <StackPanel Margin="24">

        <TextBlock Text="{Binding [settings], Source={x:Static core:Loc.I}}" FontSize="20" FontWeight="Bold" Margin="0,0,0,18"/>

        <TextBlock Text="{Binding [language], Source={x:Static core:Loc.I}}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <ComboBox x:Name="LangBox" Margin="0,0,0,16">
            <ComboBoxItem Content="English"/>
            <ComboBoxItem Content="العربية"/>
        </ComboBox>

        <TextBlock Text="{Binding [realMic], Source={x:Static core:Loc.I}}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <ComboBox x:Name="MicBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,16"/>

        <TextBlock Text="{Binding [outputDevice], Source={x:Static core:Loc.I}}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
        <ComboBox x:Name="OutBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>
        <Button HorizontalAlignment="Left" Click="Refresh_Click" Margin="0,0,0,16" Padding="12,6"
                Content="{Binding [refresh], Source={x:Static core:Loc.I}}"/>

        <TextBlock x:Name="LatencyText" Margin="0,0,0,4"/>
        <Slider x:Name="LatencySlider" Minimum="10" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                ValueChanged="Latency_Changed"/>
        <TextBlock Text="{Binding [latencyHint], Source={x:Static core:Loc.I}}" Foreground="{StaticResource MutedBrush}"
                   FontSize="12" Margin="0,4,0,18" TextWrapping="Wrap"/>

        <CheckBox x:Name="StartupBox" Margin="0,0,0,10" Content="{Binding [startWithWindows], Source={x:Static core:Loc.I}}"/>
        <CheckBox x:Name="TrayBox" Margin="0,0,0,22" Content="{Binding [closeToTray], Source={x:Static core:Loc.I}}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource AccentButton}" IsDefault="True" Click="Save_Click" MinWidth="90"
                    Content="{Binding [save], Source={x:Static core:Loc.I}}"/>
            <Button IsCancel="True" Margin="8,0,0,0" MinWidth="90"
                    Content="{Binding [cancel], Source={x:Static core:Loc.I}}"/>
        </StackPanel>
    </StackPanel>
</Window>
