<Window x:Class="EchoKey.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:EchoKey.Core"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        FlowDirection="{Binding FlowDirection, Source={x:Static core:Loc.I}}">
    <StackPanel Margin="22">
        <TextBlock x:Name="PromptText" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"
                    Content="{Binding [save], Source={x:Static core:Loc.I}}" MinWidth="90"/>
            <Button IsCancel="True" Margin="8,0,0,0" MinWidth="90"
                    Content="{Binding [cancel], Source={x:Static core:Loc.I}}"/>
        </StackPanel>
    </StackPanel>
</Window>
