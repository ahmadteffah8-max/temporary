<Window x:Class="EchoKey.Views.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:EchoKey.Core"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        FlowDirection="{Binding FlowDirection, Source={x:Static core:Loc.I}}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="22">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Margin="0,6,0,14" Foreground="{StaticResource MutedBrush}"
                   Text="{Binding [pressKey], Source={x:Static core:Loc.I}}"/>
        <Border Height="68" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource NeonBrush}"
                Background="{StaticResource SurfaceAltBrush}">
            <TextBlock x:Name="ComboText" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NeonBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" IsEnabled="False" Click="Save_Click"
                    Content="{Binding [save], Source={x:Static core:Loc.I}}" MinWidth="80" Focusable="False"/>
            <Button x:Name="RemoveButton" Margin="8,0,0,0" Click="Remove_Click" Focusable="False"
                    Content="{Binding [removeHotkey], Source={x:Static core:Loc.I}}"/>
            <Button IsCancel="True" Margin="8,0,0,0" MinWidth="80" Focusable="False"
                    Content="{Binding [cancel], Source={x:Static core:Loc.I}}"/>
        </StackPanel>
    </StackPanel>
</Window>
