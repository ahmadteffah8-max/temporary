<Window x:Class="EchoKey.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:EchoKey.Core"
        Title="EchoKey" Width="1120" Height="720" MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        FlowDirection="{Binding FlowDirection, Source={x:Static core:Loc.I}}"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- One sound card -->
        <DataTemplate x:Key="SoundCard">
            <Border x:Name="Card" Width="216" Margin="6" Padding="14,12" CornerRadius="14"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    MouseRightButtonUp="Card_RightClick">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE712;" Click="More_Click"
                                Margin="4,-4,-8,-4"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,10">
                        <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <Border Margin="10,0,0,0" CornerRadius="9" Padding="7,1" Background="{StaticResource NeonDimBrush}"
                                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ActiveCount, StringFormat='▶ ×{0}'}" Foreground="{StaticResource NeonBrush}"
                                       FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <Button Grid.Row="2" HorizontalAlignment="Left" Click="Hotkey_Click" Content="{Binding HotkeyLabel}"
                            Margin="0,0,0,10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHotkey}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource NeonBrush}"/>
                                        <Setter Property="BorderBrush" Value="#0A7FA0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HotkeyFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding Volume, Mode=TwoWay}"
                                    ToolTip="{Binding [volume], Source={x:Static core:Loc.I}}"/>
                            <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource AccentButton}" Click="Play_Click" Padding="10,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [play], Source={x:Static core:Loc.I}}"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE7F6;" Click="Preview_Click"
                                    Margin="6,0,0,0" ToolTip="{Binding [preview], Source={x:Static core:Loc.I}}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource NeonBrush}"/>
                    <Setter TargetName="Card" Property="Effect" Value="{StaticResource NeonGlow}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#55627A"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center">
                        <Run Text="Echo"/><Run Text="Key" Foreground="{StaticResource NeonBrush}"/>
                    </TextBlock>
                    <Button Margin="18,0,0,0" Padding="12,6" Click="Cable_Click" Background="Transparent" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CableFound}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding CableText}" MaxWidth="360" TextTrimming="CharacterEllipsis" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding SoundboardEnabled, Mode=TwoWay}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SoundboardEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding [soundboard], Source={x:Static core:Loc.I}}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding HotkeysEnabled, Mode=TwoWay}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HotkeysEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding [hotkeys], Source={x:Static core:Loc.I}}"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource DangerButton}" Click="StopAll_Click" Margin="0,0,8,0" ToolTip="{Binding StopAllTooltip}"
                            Content="{Binding [stopAll], Source={x:Static core:Loc.I}}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontSize="18" Click="Settings_Click"
                            ToolTip="{Binding [settings], Source={x:Static core:Loc.I}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Categories -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="6,2,0,8">
                        <TextBlock Text="{Binding [categories], Source={x:Static core:Loc.I}}" Foreground="{StaticResource MutedBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" HorizontalAlignment="Right" Padding="7,5"
                                Click="AddCategory_Click" ToolTip="{Binding [newCategory], Source={x:Static core:Loc.I}}"/>
                    </Grid>
                    <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CategoryItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseRightButtonUp="Category_RightClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Sounds -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="20,16,20,4">
                    <TextBlock Text="{Binding SelectedCategory.DisplayName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Click="AddSounds_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [addSounds], Source={x:Static core:Loc.I}}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,6,14,14">
                        <ItemsControl ItemsSource="{Binding VisibleSounds}" ItemTemplate="{StaticResource SoundCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding [dropHint], Source={x:Static core:Loc.I}}" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" LineHeight="26"
                               Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= Status line ================= -->
        <Border Grid.Row="2" Background="#2A1A22" BorderBrush="#5A2434" BorderThickness="0,1,0,0" Padding="20,8"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#FFB3C0" TextWrapping="Wrap"/>
        </Border>

        <!-- ================= Footer: mixer ================= -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto" MinWidth="130"/>
                </Grid.ColumnDefinitions>

                <!-- real microphone -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Style="{StaticResource PillToggle}" IsChecked="{Binding MicEnabled, Mode=TwoWay}" Margin="0,0,14,0"
                                  ToolTip="{Binding [micTip], Source={x:Static core:Loc.I}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding [micVolume], Source={x:Static core:Loc.I}}"/>
                        </StackPanel>
                    </ToggleButton>
                    <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding MicVolume, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="2" Text="{Binding MicVolumeText}" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- soundboard -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource NeonBrush}"/>
                        <TextBlock Text="{Binding [sbVolume], Source={x:Static core:Loc.I}}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding SoundboardVolume, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="2" Text="{Binding SoundboardVolumeText}" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- active sounds indicator -->
                <TextBlock Grid.Column="4" Text="{Binding ActiveText}" Foreground="{StaticResource NeonBrush}" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
